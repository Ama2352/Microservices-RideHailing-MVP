# -*- mode: ruby -*-
# vi: set ft=ruby :

# =============================================================================
# VM Resource Allocation (Total: 10 GB)
# k8s-master    192.168.242.10  2048 MB  2 vCPU  Control plane only
# k8s-worker-1  192.168.242.11  3072 MB  2 vCPU  SonarQube + Prometheus + Grafana
# k8s-worker-2  192.168.242.12  2048 MB  2 vCPU  dispatch-service + notification-service + Istio
# jenkins-vm    192.168.242.13  3072 MB  2 vCPU  Jenkins + Docker CI agents (DooD)
# =============================================================================

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_check_update = false

  # Cấu hình chung cho VMware
  config.vm.provider "vmware_desktop" do |v|
    v.gui = false
    v.linked_clone = true
    v.allowlist_verified = true
  end

  # ===========================================================================
  # MASTER NODE (2 GB RAM) - Control plane only, no user workloads
  # etcd + apiserver + scheduler + controller-manager + CoreDNS + Calico
  # ===========================================================================
  config.vm.define "k8s-master" do |master|
    master.vm.hostname = "k8s-master"
    master.vm.network "private_network", ip: "192.168.242.10"

    master.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "2048"
      v.vmx["numvcpus"] = "2"
    end

    # Bước 1: Cài đặt Ansible lên Master (Shell script nhẹ)
    master.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y software-properties-common
      add-apt-repository --yes --update ppa:ansible/ansible
      apt-get install -y ansible
    SHELL

    # Bước 2: Master tự chạy Playbook để cài K8s, Init Cluster và cài Calico
    master.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "playbook_master.yml"
      ansible.install_mode = "none" # Đã cài ở Bước 1
      ansible.verbose = false
    end
  end

  # ===========================================================================
  # WORKER NODE 1 (3 GB RAM) - Tooling workloads
  # SonarQube (1 Gi req / 2 Gi limit) + Prometheus (512 Mi) + Grafana (256 Mi)
  # ===========================================================================
  config.vm.define "k8s-worker-1" do |worker|
    worker.vm.hostname = "k8s-worker-1"
    worker.vm.network "private_network", ip: "192.168.242.11"

    worker.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "3072"
      v.vmx["numvcpus"] = "2"
    end

    # Chỉ cài môi trường nền (Docker, Kubelet). KHÔNG JOIN TỰ ĐỘNG.
    worker.vm.provision "shell", path: "worker_setup.sh"
  end

  # ===========================================================================
  # WORKER NODE 2 (2 GB RAM) - Application workloads
  # dispatch-service + notification-service + Istio sidecars
  # ===========================================================================
  config.vm.define "k8s-worker-2" do |worker|
    worker.vm.hostname = "k8s-worker-2"
    worker.vm.network "private_network", ip: "192.168.242.12"

    worker.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "2048"
      v.vmx["numvcpus"] = "2"
    end

    # Chỉ cài môi trường nền (Docker, Kubelet). KHÔNG JOIN TỰ ĐỘNG.
    worker.vm.provision "shell", path: "worker_setup.sh"
  end

  # ===========================================================================
  # JENKINS VM (3 GB RAM) - Jenkins controller + Docker CI agents
  # All CI stages run as ephemeral Docker containers on this VM (DooD).
  # CD stages send kubectl commands to K8s via SA token over the private net.
  # ===========================================================================
  config.vm.define "jenkins-vm" do |jenkins|
    jenkins.vm.hostname = "jenkins-vm"
    jenkins.vm.network "private_network", ip: "192.168.242.13"

    jenkins.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "3072"
      v.vmx["numvcpus"] = "2"
    end

    jenkins.vm.provision "shell", path: "platform/jenkins/setup-jenkins-vm.sh"
  end
end