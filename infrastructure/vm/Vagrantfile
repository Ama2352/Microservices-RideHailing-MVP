# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_check_update = false

  # Cấu hình chung cho VMware
  config.vm.provider "vmware_desktop" do |v|
    v.gui = false
    v.linked_clone = true
    v.allowlist_verified = true
  end

  # ===========================================================================
  # MASTER NODE (3GB RAM) - Dùng Ansible để tự động hóa toàn bộ
  # ===========================================================================
  config.vm.define "k8s-master" do |master|
    master.vm.hostname = "k8s-master"
    master.vm.network "private_network", ip: "192.168.242.10"
    
    master.vm.provider "vmware_desktop" do |v|
      v.vmx["memsize"] = "3072"
      v.vmx["numvcpus"] = "2"
    end

    # Bước 1: Cài đặt Ansible lên Master (Shell script nhẹ)
    master.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y software-properties-common
      add-apt-repository --yes --update ppa:ansible/ansible
      apt-get install -y ansible
    SHELL

    # Bước 2: Master tự chạy Playbook để cài K8s, Init Cluster và cài Calico
    master.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "playbook_master.yml"
      ansible.install_mode = "none" # Đã cài ở Bước 1
      ansible.verbose = false
    end
  end

  # ===========================================================================
  # WORKER NODES (3GB RAM Each) - Dùng Shell Script (Không Ansible)
  # ===========================================================================
  (1..2).each do |i|
    config.vm.define "k8s-worker-#{i}" do |worker|
      worker.vm.hostname = "k8s-worker-#{i}"
      worker.vm.network "private_network", ip: "192.168.242.1#{i}"
      
      worker.vm.provider "vmware_desktop" do |v|
        v.vmx["memsize"] = "3072"
        v.vmx["numvcpus"] = "2"
      end

      # Chỉ cài môi trường nền (Docker, Kubelet). KHÔNG JOIN TỰ ĐỘNG.
      worker.vm.provision "shell", path: "worker_setup.sh"
    end
  end
end